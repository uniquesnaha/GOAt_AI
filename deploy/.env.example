# Copy to deploy/.env and fill in before `docker compose up`.

# Required for streaming speech-to-text (see backend/app/stt/sarvam_client.py)
SARVAM_API_KEY=

# Only needed if you're not using docker-compose's default paths/network.
# QDRANT_URL=http://qdrant:6333
# GOAT_DATA_ROOT=/data
GOAT_CORPUS_PROFILE=25k
